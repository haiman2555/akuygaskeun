{
  "name": "motion-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Repo motion editing portrait 1080x1920 (footage 4K) berbasis Remotion, siap dikendalikan Claude Code.",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "still": "remotion still",
    "render": "remotion render",
    "render:draft": "remotion render --scale=0.5 --crf=28",
    "render:final": "remotion render --env-file=.env.render --codec=h264 --crf=16 --pixel-format=yuv420p --audio-bitrate=320k",
    "proxies": "bash scripts/make-proxies.sh",
    "probe": "bash scripts/probe.sh",
    "extract-ref": "bash scripts/extract-reference.sh",
    "new-project": "bash scripts/new-project.sh"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "@remotion/google-fonts": "4.0.290",
    "@remotion/transitions": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
